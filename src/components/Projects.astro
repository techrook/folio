---
interface Project {
  title: string;
  description: string;
  tech: string[];
  github?: string;
  live?: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section class="mt-12">
  <h2 class="text-lg font-semibold tracking-tight mb-6">Projects</h2>
  
  <div class="space-y-8">
    {projects.map((project) => (
      <article class="border-l-2 border-neutral-200 dark:border-neutral-800 pl-4">
        <header class="mb-2">
          <h3 class="font-medium text-base">{project.title}</h3>
          <p class="text-sm text-neutral-700 dark:text-neutral-300 mt-1 leading-relaxed">
            {project.description}
          </p>
        </header>
        
        <!-- Tech Stack -->
        <div class="flex flex-wrap gap-1.5 mt-3">
          {project.tech.map((t) => (
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
              {t}
            </span>
          ))}
        </div>
        
        <!-- Links (only render if available) -->
        {(project.github || project.live) && (
          <div class="flex gap-4 mt-3 text-sm">
            {project.github && (
              <a 
                href={project.github} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 hover:underline underline-offset-4"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                GitHub
              </a>
            )}
            {project.live && (
              <a 
                href={project.live} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 hover:underline underline-offset-4"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                Live Demo
              </a>
            )}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
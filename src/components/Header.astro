---
interface Props {
  name: string;
  tagline: string;
  links: Array<{ text: string; href: string }>;
}

const { name, tagline, links } = Astro.props;
---

<header class="flex flex-row justify-around md:flex-row justify-around pt-[120px]">
  <div>
    <h1 class="text-xl font-semibold tracking-tight">
      {name}
    </h1>
    <p class="text-sm text-neutral-500 mt-1 leading-relaxed" set:html={tagline} />
  </div>

  <nav class="mt-3 md:mt-0">
    <ul class="text-sm space-y-1.5 text-left md:text-right">
      {links.map((link) => (
        <li>
          <a href={link.href} class="hover:underline underline-offset-4">
            {link.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
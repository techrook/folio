---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Career from '../components/Career.astro';
import Projects from '../components/Projects.astro';
// Removed Footer import since it's already in Layout.astro
import meImage from '../assets/me1.jpeg'; 

const experiences = [
  {
    company: "Peach Blossom",
    role: "Backend Engineer",
    location: "Remote",
    period: "Oct 2024 - Oct 2025",
    highlights: [
      "Part of 6-person team developing digital transcript and school management system",
      "Designed microservice architecture for student records, improving data consistency",
      "Built queue-based batch processing service for large-scale student record uploads"
    ]
  },
  {
    company: "Freelancing",
    role: "Software Engineer",
    location: "Remote",
    period: "2023 - Present",
    highlights: [
      "Kervv: Built job marketplace with NestJS, TypeScript, MongoDB and JWT auth",
      "RightTimeEntertainment: Developed RESTful API for media management dashboard",
      "Implemented role-based permissions and secure admin endpoints"
    ]
  },
  {
    company: "Envoice",
    role: "Software Engineer",
    location: "Kano",
    period: "Jan 2025 - Present",
    highlights: [
      "Developed SaaS for online vendors to create shareable invoices",
      "Implemented event-driven architecture with NestJS, BullMQ, and Redis",
      "Created comprehensive API documentation using Swagger"
    ]
  },
  {
    company: "Shamrock Innovation",
    role: "Web Developer Intern",
    location: "Kano, Nigeria",
    period: "Dec 2022 - May 2023",
    highlights: [
      "Built responsive UI for organizational health application using React and Tailwind",
      "Developed RESTful APIs with Node.js to support application features"
    ]
  }
];

const education = [
  {
    institution: "Bayero University Kano",
    degree: "BSc Cyber Security",
    location: "Kano, Nigeria",
    year: "May 2024"
  },
  {
    institution: "Altschool of Engineering",
    degree: "Diploma, Backend Engineering",
    location: "Remote",
    year: "Jun 2023"
  }
];

const projects = [
  {
    title: "Envoice",
    description: "SaaS platform enabling online vendors to create and share professional invoices with their clients. Features event-driven background processing for reliable invoice generation.",
    tech: ["NestJS", "TypeScript", "MongoDB", "Redis", "BullMQ"],
    github: "https://github.com/yourusername/envoice",
    live: "https://envoice.app"
  },
  {
    title: "Kervv",
    description: "Job marketplace platform connecting employers with candidates. Includes full authentication system with role-based permissions and optimized database queries.",
    tech: ["NestJS", "TypeScript", "MongoDB", "JWT"],
    github: "https://github.com/yourusername/kervv"
  },
  {
    title: "RightTime Media API",
    description: "RESTful API powering a media-focused web application with admin dashboard. Handles secure upload and management of audio and image files.",
    tech: ["Node.js", "Express.js", "MongoDB"],
    live: "https://righttime.example.com"
  },
  {
    title: "iTranscript",
    description: "Digital transcript and school management system built with microservice architecture. Includes batch processing for large-scale student record uploads.",
    tech: ["Microservices", "Queue Systems", "Node.js"],
  }
];
---

<Layout title="Itohowo Monday — Software Engineer">
  
  <Header 
    name="Itohowo Monday" 
    tagline="Software Engineer<br />building scalable systems"
    links={[
      { text: "about", href: "/about" },
      { text: "projects", href: "/projects" },
      { text: "writing", href: "/writing" }
    ]}
  />

  <!-- Fixed image classes: added w-full and md:w-1/2 -->
  <figure class="flex justify-center mt-8">
    <img 
      src={meImage.src} 
      alt="Itohowo Monday" 
      class="w-full md:w-1/2 h-auto rounded-sm object-cover" 
    />
  </figure>

  <!-- Replaced arbitrary pt-[60px] with standard Tailwind mt-16 and mt-8 -->
  <div class="mt-16">
    <p class="text-neutral-700 dark:text-neutral-300 leading-relaxed">
      Kon'nichiwa, I'm Itohowo; a software engineer with over 3 years of experience designing scalable, high-performance software systems. I am constantly learning and building what I wish existed.
    </p>

    <p class="mt-8 text-neutral-700 dark:text-neutral-300 leading-relaxed">
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Ratione perspiciatis aliquid eligendi nostrum, quod ipsum aliquam eum. Quam, laboriosam officia dolorum explicabo cum facere est ea neque exercitationem, accusamus porro.
    </p>
  </div>

  <Career experiences={experiences} education={education} />
  <Projects projects={projects} />
  
  <!-- Footer removed from here, it's already in Layout.astro -->

</Layout>
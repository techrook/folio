---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import meImage from '../assets/me1.jpeg'; 
---

<Layout title="Meekbill — Software Designer">
  
  <Header 
    name="Itohowo Monday" 
    tagline="SWE"
    links={[
      { text: "about", href: "/about" },
      { text: "projects", href: "/projects" },
      { text: "writing", href: "/writing" }
    ]}
  />

  <figure class="flex justify-center pt-[120px] ">
    <img 
      src={meImage.src} 
      alt="Meekbill" 
      class="w-7/12 md:w-7/12 h-auto rounded-sm object-cover " 
    />
  </figure>

</Layout>